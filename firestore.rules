rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['id', 'email', 'createdAt']) &&
        data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'lastLoginAt']) &&
        data.id == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64));
    }

    // Validation for ToolHistoryItem
    function isValidToolHistoryItem(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'toolId', 'toolName', 'fileName', 'status', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'toolId', 'toolName', 'fileName', 'fileSize', 'resultSize', 'pageCount', 'status', 'createdAt']) &&
        data.userId == userId &&
        data.userId is string && data.userId.size() <= 128 &&
        data.id is string && data.id.size() <= 128 &&
        data.toolId is string && data.toolId.size() <= 64 &&
        data.toolName is string && data.toolName.size() <= 128 &&
        data.fileName is string && data.fileName.size() <= 256 &&
        (data.status == 'success' || data.status == 'failed') &&
        (!('fileSize' in data) || (data.fileSize is number && data.fileSize >= 0)) &&
        (!('resultSize' in data) || (data.resultSize is number && data.resultSize >= 0)) &&
        (!('pageCount' in data) || (data.pageCount is number && data.pageCount >= 0)) &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Validation for UserFavorite
    function isValidUserFavorite(data, userId) {
      return data.keys().hasAll(['toolId', 'userId', 'addedAt']) &&
        data.keys().hasOnly(['toolId', 'userId', 'addedAt']) &&
        data.userId == userId &&
        data.userId is string && data.userId.size() <= 128 &&
        data.toolId is string && data.toolId.size() <= 64 &&
        data.addedAt is string && data.addedAt.size() <= 64;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users can never be queried as a whole list
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      // Tool History subcollection
      match /history/{historyId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(historyId) && isValidToolHistoryItem(incoming(), userId);
        allow update: if false; // History items are immutable logs
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
      }

      // Favorites subcollection
      match /favorites/{toolId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(toolId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(toolId) && isValidUserFavorite(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(toolId);
      }
    }
  }
}
